FV_div_a_grad_perp_upwind_solution = -39.4784176043574*(0.3*cos(6.28318530717959*Rg) + 1.0)*sin(6.28318530717959*Rg)*cos(6.28318530717959*Zg) + (-39.4784176043574*Rg*(0.3*cos(6.28318530717959*Rg) + 1.0)*sin(6.28318530717959*Rg)*cos(6.28318530717959*Zg) - 11.8435252813072*Rg*sin(6.28318530717959*Rg)*cos(6.28318530717959*Rg)*cos(6.28318530717959*Zg) + 6.28318530717959*(0.3*cos(6.28318530717959*Rg) + 1.0)*cos(6.28318530717959*Rg)*cos(6.28318530717959*Zg))/Rg
