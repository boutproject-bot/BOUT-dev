#!/usr/bin/env python3
#
# MMS test of the FCI operators on unstructured poloidal meshes
#
# Unstructured counterpart of ../fci: same magnetic field, domain,
# manufactured solutions and pass criterion. The poloidal planes are
# triangle meshes stored "nodes along x" (nz = 1), generated by
# zoidberg.unstructured, and the parallel maps use the precomputed
# interpolation. In addition, the perpendicular diffusion operator
# FV::Div_a_Grad_perp_FCI is tested, together with its conservation and
# independence of the domain decomposition.
#

import argparse
import inspect
import json
import os
import pathlib
import shutil
import sys
from concurrent.futures import ProcessPoolExecutor
from time import time

from boutdata.collect import collect
from boututils.run_wrapper import build_and_log, launch_safe
from netCDF4 import Dataset
from numpy import abs as npabs
from numpy import array, log, polyfit
from numpy import max as npmax
from zoidberg import unstructured as zu

# Global parameters
DIRECTORY = "data"
NPROC = 2
MTHREAD = 2
OPERATORS = (
    "grad_par",
    "grad2_par2",
    "div_par",
    "div_par_K_grad_par",
    "div_par_K_grad_par_mod",
    "div_par_K_grad_par_som",
    "so_grad_par",
    "so_div_par",
    "so_laplace_par",
    "so_div_par_K_grad_par",
    "laplace_par",
    "FV_div_par_mod",
    "FV_div_par_fvv",
    "FV_div_par_mod_reconstruct",
    "FV_div_par_fvv_reconstruct",
    "FV_div_a_grad_perp",
    "FV_div_a_grad_perp_flowZ",
    "FV_div_a_grad_perp_upwind",
)

# As in ../fci; div_par_fvv is first order
# (The upwinded perpendicular operator uses a second-order upwind
# reconstruction, so it is expected at order 2.)
operator_order = {
    "FV_div_par_fvv": 1,
    # With values reconstructed at the cell faces (limited slopes, as on
    # field-aligned grids), measured: at n = 64 the l-2 error of div_par_fvv
    # is 13 times smaller than without, and that of div_par_mod the same;
    # the orders at the smallest spacing are 1.54 and 1.65 (fits 2.2 and
    # 2.7). The maximum error of div_par_mod is 6.5 times that without,
    # probably where the limiter clips the slopes near extrema.
    "FV_div_par_mod_reconstruct": 1.5,
    "FV_div_par_fvv_reconstruct": 1.5,
}
# Support operators (PetscOperators::Parallel). The gradient converges at
# order 2 (asserted). The divergence, built as the adjoint of the gradient, is
# not locally consistent on these irregular meshes: the adjoint of the
# interpolation does not return each cell its own volume, so its error does
# not decrease with resolution (so_div_par 0.14, 0.14, 0.25, 0.43 for
# n = 8...64), and neither do the operators built from it (Div_par_Grad_par,
# Div_par_K_Grad_par; the solution of a diffusion problem still converges, at
# order 0.6-0.9). On structured grids all four
# converge at order 2 (../fci). Their orders are reported, not asserted; the
# errors must stay below these bounds (regression check, about 1.5x the
# measured largest error).
RECORD_ONLY = {
    "div_par_K_grad_par_som": 0.15,
    "so_div_par": 0.65,
    "so_laplace_par": 0.15,
    "so_div_par_K_grad_par": 0.15,
}
# Same for the cylindrical sheared case
RECORD_ONLY_CYL = {
    "div_par_K_grad_par_som": 0.3,
    "so_div_par": 0.3,
    "so_laplace_par": 0.3,
    "so_div_par_K_grad_par": 0.3,
}
# Resolution in y and z; the number of R layers is fixed (as NX is in ../fci)
NLIST = [8, 16, 32, 64]
dx = 1.0 / array(NLIST)

# Resolution used for the decomposition and conservation checks
N_CHECK = 16


def quiet_collect(name: str, path: str = DIRECTORY) -> float:
    # Index to return a plain (numpy) float rather than `BoutArray`
    return collect(
        name,
        tind=[1, 1],
        info=False,
        path=path,
        xguards=False,
        yguards=False,
    )[()]


def assert_convergence(error, dx, name, expected) -> bool:
    fit = polyfit(log(dx), log(error), 1)
    order = fit[0]
    print(f"{name} convergence order = {order:f} (fit)", end="")

    order = log(error[-2] / error[-1]) / log(dx[-2] / dx[-1])
    print(f", {order:f} (small spacing)", end="")

    if expected is None:
        print("\t............ recorded")
        return True

    # Should be close to the expected order
    success = order > expected * 0.95
    print(f"\t............ {'PASS' if success else 'FAIL'}")

    return success


def gridfile(n: int) -> str:
    return f"mesh.{n}.fci.nc"


# The grids whose checks use the K2 matrices request them (zoidberg writes
# them by default only with centroid unknowns); the others are generated
# without, to save time
ZOIDBERG_K2 = "k2" in inspect.signature(zu.build_grid_data).parameters


def make_test_grid(family: str, n: int, filename: str, k2: bool = True):
    options = {"k2": k2} if ZOIDBERG_K2 else {}
    zu.make_test_grid(family, n, filename=filename, **options)


def has_k2(filename: str) -> bool:
    with Dataset(filename) as ds:
        return "k2_forward_weights" in ds.variables


def k2_unavailable(what: str) -> list[str]:
    """K2 checks need grids with the K2 matrices (written by zoidberg):
    skipped with a message, or a failure if BOUT_TEST_REQUIRE_K2 is set"""
    message = f"SKIPPED: {what}: the grid has no K2 matrices (k2_forward_weights)"
    print(message)
    if os.environ.get("BOUT_TEST_REQUIRE_K2", "0") not in ("", "0"):
        return [message + " (BOUT_TEST_REQUIRE_K2 is set)"]
    return []


def make_centroid_grid(n: int, filename: str):
    """bout_mms_iso grid with the unknowns at the dual-cell centroids"""
    pol, field, layout = zu.family_spec("bout_mms_iso", n)
    pol.use_centroid_dofs()
    zu.make_unstructured_grid(filename, pol, field, **layout)


def make_grids():
    """All grids of this test, built in NPROC processes (they are independent),
    largest first"""
    with ProcessPoolExecutor(NPROC) as pool:
        futures = []
        if hasattr(zu, "family_spec"):
            for n in reversed(ISO_NLIST):
                futures.append(
                    pool.submit(make_centroid_grid, n, f"mesh_iso_centroid.{n}.fci.nc")
                )
        for n in reversed(ISO_NLIST):
            futures.append(
                pool.submit(make_test_grid, "bout_mms_iso", n, f"mesh_iso.{n}.fci.nc")
            )
        for n in reversed(CYLP_NLIST):
            gridname = f"mesh_cyl_sheared.{n}.fci.nc"
            futures.append(
                pool.submit(
                    make_test_grid, "bout_mms_cyl_sheared", n, gridname, k2=False
                )
            )
        for n in reversed(CYL_NLIST):
            gridname = f"mesh_cyl.{n}.fci.nc"
            futures.append(
                pool.submit(make_test_grid, "bout_mms_cyl", n, gridname, k2=False)
            )
        for n in reversed(NLIST):
            futures.append(
                pool.submit(make_test_grid, "bout_mms", n, gridfile(n), k2=False)
            )
        for future in futures:
            future.result()


def run(nz: int, args: str, nproc: int = NPROC, path: str = DIRECTORY):
    if path != DIRECTORY:
        pathlib.Path(path).mkdir(exist_ok=True)
        shutil.copy(pathlib.Path(DIRECTORY) / "BOUT.inp", path)
    cmd = f"./fci_mms -d {path} {args} mesh:file={gridfile(nz)}"
    print(f"Running command: {cmd}", end="")

    start = time()
    status, out = launch_safe(cmd, nproc=nproc, mthread=MTHREAD, pipe=True)
    print(f" ... done in {time() - start:.3}s")

    pathlib.Path(path, f"run.log.{nz}").write_text(out)

    if status:
        print(f"Run failed!\nOutput was:\n{out}")
        sys.exit(status)


def conservation(path: str = DIRECTORY) -> bool:
    integral = abs(quiet_collect("FV_div_a_grad_perp_integral", path))
    ok = integral < 1e-12
    print(f"FV_div_a_grad_perp relative volume integral = {integral:.3e}", end="")
    print(f"\t............ {'PASS' if ok else 'FAIL'}")
    # Closed planes: no wall nodes, so no flow into walls
    wall_flow = quiet_collect("FV_div_a_grad_perp_wall_flow", path)
    wall_ok = wall_flow == 0.0
    print(f"FV_div_a_grad_perp flow into the walls = {wall_flow:.3e}", end="")
    print(f"\t............ {'PASS' if wall_ok else 'FAIL'}")
    return ok and wall_ok


def run_fci_operators(nz: int, args: str) -> dict[str, dict[str, float]]:
    run(nz, args)
    return {
        operator: {
            "l_2": quiet_collect(f"{operator}_l_2"),
            "l_inf": quiet_collect(f"{operator}_l_inf"),
        }
        for operator in OPERATORS
    }


# Solution error of the steady problem (I - c L) f = S with the parallel
# conduction operator L (K = 1), for both methods (see fci_mms.cxx). Original
# must converge at second order; the support operator converges slowly on
# these meshes (order 0.7 for c = 1, 1.4 for c = 100 at the finest step), so
# its errors are bounded (about 1.5x the measured largest error), not its
# order asserted.
SOLVE_C = (1, 100)
SOLVE_KEYS = [f"solve_{m}_c{c}" for c in SOLVE_C for m in ("orig", "som")]
SOLVE_BOUNDS = {"solve_som_c1": 0.03, "solve_som_c100": 0.5}


def check_solution_errors(errors: dict[str, list[float]]) -> list[str]:
    failures = []
    for key, values in errors.items():
        print(f"{key} solution errors: " + ", ".join(f"{v:.3e}" for v in values))
        if key in SOLVE_BOUNDS:
            assert_convergence(values, dx, key, None)
            ok = max(values) < SOLVE_BOUNDS[key]
            print(
                f"{key} largest error {max(values):.3e} < {SOLVE_BOUNDS[key]}", end=""
            )
            print(f"\t............ {'PASS' if ok else 'FAIL'} (order not asserted)")
        else:
            ok = assert_convergence(values, dx, key, 2)
        if not ok:
            failures.append(key)
    return failures


def transpose(
    errors: list[dict[str, dict[str, float]]],
) -> dict[str, dict[str, list[float]]]:
    """Turn a list of {operator: error} into a dict of {operator: [errors]}"""

    kinds = ("l_2", "l_inf")
    result = {operator: {kind: [] for kind in kinds} for operator in OPERATORS}
    for error in errors:
        for k, v in error.items():
            for kind in kinds:
                result[k][kind].append(v[kind])
    return result


def check_fci_operators(name: str, case: dict):
    failures = []
    all_errors = []
    solve_errors = {key: [] for key in SOLVE_KEYS}

    for n in NLIST:
        errors = run_fci_operators(n, case["args"])
        all_errors.append(errors)
        if case.get("solve"):
            for key in SOLVE_KEYS:
                solve_errors[key].append(quiet_collect(f"{key}_error"))
                if quiet_collect(f"{key}_converged") != 1:
                    failures.append(f"{key} GMRES not converged n={n}")
        if not conservation():
            failures.append(f"FV_div_a_grad_perp conservation {name} n={n}")

        for operator in OPERATORS:
            l_2 = errors[operator]["l_2"]
            l_inf = errors[operator]["l_inf"]
            print(f"{operator} errors: l-2 {l_2:f} l-inf {l_inf:f}")

    final_errors = transpose(all_errors)
    for operator in OPERATORS:
        test_name = f"{operator} {name}"
        if operator in RECORD_ONLY:
            assert_convergence(final_errors[operator]["l_2"], dx, test_name, None)
            bound = RECORD_ONLY[operator]
            worst = max(final_errors[operator]["l_2"])
            ok = worst < bound
            print(f"{test_name} largest l-2 error {worst:.3e} < {bound}", end="")
            print(f"\t............ {'PASS' if ok else 'FAIL'} (order not asserted)")
            if not ok:
                failures.append(test_name)
            continue
        success = assert_convergence(
            final_errors[operator]["l_2"],
            dx,
            test_name,
            operator_order.get(operator, case["order"]),
        )
        if not success:
            failures.append(test_name)

    if case.get("solve"):
        failures.extend(check_solution_errors(solve_errors))
        final_errors["solution_errors"] = solve_errors

    return final_errors, failures


def check_decomposition(cases: dict) -> list[str]:
    """Results must not depend on the domain decomposition"""
    reference = "data_np1"
    run(N_CHECK, "NXPE=1", nproc=1, path=reference)
    failures = []
    for name, case in cases.items():
        path = f"data_{name.split()[-1].replace('=', '')}"
        run(N_CHECK, case["args"], path=path)
        for operator in OPERATORS:
            a = collect(f"{operator}_result", path=reference, info=False, xguards=False)
            b = collect(f"{operator}_result", path=path, info=False, xguards=False)
            diff = npmax(npabs(a - b)) / npmax(npabs(a))
            ok = diff < 1e-12
            print(
                f"{operator} {name} vs 1 rank: max relative difference {diff:.3e}",
                end="",
            )
            print(f"\t............ {'PASS' if ok else 'FAIL'}")
            if not ok:
                failures.append(f"{operator} decomposition {name}")
    return failures


# Cylindrical case: perpendicular operator only (pure toroidal field,
# annulus with Dirichlet walls); see mms.py
CYL_DIRECTORY = "data_cyl"
CYL_NLIST = [8, 16, 32]
CYL_OPERATORS = (
    "FV_div_a_grad_perp",
    "FV_div_a_grad_perp_flowZ",
    "FV_div_a_grad_perp_upwind",
)


def check_cylindrical() -> list[str]:
    errors = {operator: [] for operator in CYL_OPERATORS}
    failures = []
    for n in CYL_NLIST:
        gridname = f"mesh_cyl.{n}.fci.nc"
        cmd = f"./fci_mms -d {CYL_DIRECTORY} NXPE=1 mesh:file={gridname}"
        print(f"Running command: {cmd}", end="")
        start = time()
        status, out = launch_safe(cmd, nproc=NPROC, mthread=MTHREAD, pipe=True)
        print(f" ... done in {time() - start:.3}s")
        pathlib.Path(CYL_DIRECTORY, f"run.log.{n}").write_text(out)
        if status:
            print(f"Run failed!\nOutput was:\n{out}")
            sys.exit(status)
        for operator in CYL_OPERATORS:
            errors[operator].append(quiet_collect(f"{operator}_l_2", CYL_DIRECTORY))
        # Dirichlet walls: the divergence and the flow into the walls
        # integrate to zero together, and that flow is not small
        integral = abs(quiet_collect("FV_div_a_grad_perp_wall_integral", CYL_DIRECTORY))
        wall_flow = quiet_collect("FV_div_a_grad_perp_wall_flow", CYL_DIRECTORY)
        ok = integral < 1e-12 and wall_flow > 1e-3
        print(
            f"FV_div_a_grad_perp cylindrical n={n}: with the flow into the walls "
            f"{integral:.3e} (that flow {wall_flow:.3e})\t............ "
            f"{'PASS' if ok else 'FAIL'}"
        )
        if not ok:
            failures.append(f"FV_div_a_grad_perp wall balance cylindrical n={n}")
    spacing = 1.0 / array(CYL_NLIST)
    for operator in CYL_OPERATORS:
        name = f"{operator} cylindrical"
        if not assert_convergence(errors[operator], spacing, name, 2):
            failures.append(name)
    return failures


# Cylindrical case with a sheared field: parallel operators (see mms.py)
CYLP_DIRECTORY = "data_cyl_sheared"
CYLP_NLIST = [8, 16, 32]
CYLP_OPERATORS = (
    "grad_par",
    "div_par_K_grad_par_mod",
    "div_par_K_grad_par_som",
    "so_grad_par",
    "so_div_par",
    "so_laplace_par",
    "so_div_par_K_grad_par",
)


def check_cylindrical_sheared() -> list[str]:
    errors = {operator: [] for operator in CYLP_OPERATORS}
    failures = []
    for n in CYLP_NLIST:
        gridname = f"mesh_cyl_sheared.{n}.fci.nc"
        cmd = f"./fci_mms -d {CYLP_DIRECTORY} NXPE=1 mesh:file={gridname}"
        print(f"Running command: {cmd}", end="")
        start = time()
        status, out = launch_safe(cmd, nproc=NPROC, mthread=MTHREAD, pipe=True)
        print(f" ... done in {time() - start:.3}s")
        pathlib.Path(CYLP_DIRECTORY, f"run.log.{n}").write_text(out)
        if status:
            print(f"Run failed!\nOutput was:\n{out}")
            sys.exit(status)
        for operator in CYLP_OPERATORS:
            errors[operator].append(quiet_collect(f"{operator}_l_2", CYLP_DIRECTORY))
        # Support-operator conservation in the physical volume (B5)
        integral = abs(quiet_collect("div_par_K_grad_par_som_integral", CYLP_DIRECTORY))
        ok = integral < 1e-12
        print(
            f"div_par_K_grad_par_som cylindrical sheared n={n}: relative physical-volume "
            f"integral {integral:.3e}\t............ {'PASS' if ok else 'FAIL'}"
        )
        if not ok:
            failures.append(f"div_par_K_grad_par_som conservation cylindrical n={n}")
    spacing = 1.0 / array(CYLP_NLIST)
    for operator in CYLP_OPERATORS:
        name = f"{operator} cylindrical sheared"
        if operator in RECORD_ONLY:
            assert_convergence(errors[operator], spacing, name, None)
            worst = max(errors[operator])
            ok = worst < RECORD_ONLY_CYL[operator]
            print(
                f"{name} largest l-2 error {worst:.3e} < {RECORD_ONLY_CYL[operator]}"
                f"\t............ {'PASS' if ok else 'FAIL'} (order not asserted)"
            )
            if not ok:
                failures.append(name)
        elif not assert_convergence(errors[operator], spacing, name, 2):
            failures.append(name)
    return failures


# Isotropic family (zoidberg "bout_mms_iso"): same geometry, field and
# manufactured solution as the main case, but nR = n/8 and jitter in R and Z,
# so that the plane mesh is isotropic at every resolution (the main family
# keeps nR = 8 and goes from anisotropic to isotropic within n = 8...64).
# Orders are recorded, not asserted.
#
# The K2 divergence (conduction_method = PetscOperatorK2) is recorded here
# too, with an error bound (about 1.5x the measured largest error,
# 2.3e-3, 1.1e-3, 6.7e-4) and a lower bound 1.4 of its order (1.70). The
# unknowns of this family are the mesh nodes, which lie 0.12-0.2 h (rms)
# from the centroids of their dual cells, while K2 gives the dual-cell
# average: its asserted orders are checked on the centroid variant below. The energy test (random initial
# state, explicit RK4 to t = 100) runs at n = 32.
ISO_DIRECTORY = "data_iso"
ISO_NLIST = [32, 48, 64]
ISO_K2_BOUND = 3.5e-3
ISO_K2_ORDER_BOUND = 1.4
K2_ENERGY_TIME = 100
# The energy test is deterministic (seeded); measured: E(t) never exceeds E(0)
K2_ENERGY_BOUND = 1.0 + 1e-12


def check_energy(path: str, name: str) -> bool:
    growth = quiet_collect("energy_k2_max_ratio", path)
    final = quiet_collect("energy_k2_final_ratio", path)
    steps = quiet_collect("energy_k2_steps", path)
    ok = growth <= K2_ENERGY_BOUND
    print(
        f"K2 energy {name}: max E(t)/E(0) - 1 = {growth - 1:.1e} <= {K2_ENERGY_BOUND - 1:.0e} "
        f"(E({K2_ENERGY_TIME})/E(0) = {final:.3e}, {steps:.0f} RK4 steps)"
        f"\t............ {'PASS' if ok else 'FAIL'}"
    )
    return ok


def check_isotropic() -> tuple[dict, list[str]]:
    pathlib.Path(ISO_DIRECTORY).mkdir(exist_ok=True)
    shutil.copy(pathlib.Path(DIRECTORY) / "BOUT.inp", ISO_DIRECTORY)
    errors = {operator: [] for operator in OPERATORS}
    k2_errors = []
    failures = []
    k2 = True
    for n in ISO_NLIST:
        gridname = f"mesh_iso.{n}.fci.nc"
        k2 = k2 and has_k2(gridname)
        cmd = f"./fci_mms -d {ISO_DIRECTORY} NXPE=1 mesh:file={gridname}"
        if k2:
            cmd += " k2=true"
            if n == ISO_NLIST[0]:
                cmd += f" energy_time={K2_ENERGY_TIME}"
        print(f"Running command: {cmd}", end="")
        start = time()
        status, out = launch_safe(cmd, nproc=NPROC, mthread=MTHREAD, pipe=True)
        print(f" ... done in {time() - start:.3}s")
        pathlib.Path(ISO_DIRECTORY, f"run.log.{n}").write_text(out)
        if status:
            print(f"Run failed!\nOutput was:\n{out}")
            sys.exit(status)
        for operator in OPERATORS:
            errors[operator].append(quiet_collect(f"{operator}_l_2", ISO_DIRECTORY))
        if k2:
            k2_errors.append(quiet_collect("div_par_K_grad_par_k2_l_2", ISO_DIRECTORY))
            if n == ISO_NLIST[0] and not check_energy(
                ISO_DIRECTORY, f"isotropic n={n}"
            ):
                failures.append(f"K2 energy isotropic n={n}")
    spacing = 1.0 / array(ISO_NLIST)
    for operator in OPERATORS:
        assert_convergence(errors[operator], spacing, f"{operator} isotropic", None)
    result = {"n": ISO_NLIST, **{op: {"l_2": e} for op, e in errors.items()}}
    if not k2:
        return result, failures + k2_unavailable("K2 on bout_mms_iso")
    name = "div_par_K_grad_par_k2 isotropic"
    # Lower bound of the order (assert_convergence accepts 0.95 x expected)
    ok = assert_convergence(k2_errors, spacing, name, ISO_K2_ORDER_BOUND / 0.95)
    ok = ok and max(k2_errors) < ISO_K2_BOUND
    print(f"{name} largest l-2 error {max(k2_errors):.3e} < {ISO_K2_BOUND}", end="")
    print(f"\t............ {'PASS' if ok else 'FAIL'} (order >= {ISO_K2_ORDER_BOUND})")
    if not ok:
        failures.append(name)
    result["div_par_K_grad_par_k2"] = {"l_2": k2_errors}
    return result, failures


# K2 on the isotropic family with the unknowns at the centroids of the dual
# cells, as zoidberg places them on gmsh meshes (the production case): the
# grid is built from the bout_mms_iso specification with use_centroid_dofs()
# (zoidberg.unstructured.make_test_grid has no option for it). Asserted: the
# solution error of (I - c L) f = S converges at order >= 1.8 for c = 1
# (measured 2.07 on 48 -> 64) and is recorded with a lower bound for
# c = 100 (measured 2.04) and for the operator itself with a variable K
# (measured 1.87); the volume integral vanishes. GMRES tolerance 1e-6 (the
# errors agree with 1e-10 to 5 digits, in about half the iterations).
ISOC_DIRECTORY = "data_iso_centroid"
K2_ORDER_SOLVE_C1 = 1.8
K2_ORDER_BOUNDS = {"solve_k2_c100": 1.7, "div_par_K_grad_par_k2": 1.6}


def check_k2_centroid() -> tuple[dict, list[str]]:
    if not hasattr(zu, "family_spec"):
        return {}, k2_unavailable("K2 on the centroid isotropic family (old zoidberg)")
    pathlib.Path(ISOC_DIRECTORY).mkdir(exist_ok=True)
    shutil.copy(pathlib.Path(DIRECTORY) / "BOUT.inp", ISOC_DIRECTORY)
    keys = ("solve_k2_c1", "solve_k2_c100", "div_par_K_grad_par_k2")
    errors = {key: [] for key in keys}
    failures = []
    for n in ISO_NLIST:
        gridname = f"mesh_iso_centroid.{n}.fci.nc"
        if not has_k2(gridname):
            return {}, k2_unavailable(f"K2 on {gridname}")
        cmd = (
            f"./fci_mms -d {ISOC_DIRECTORY} NXPE=1 mesh:file={gridname} k2=true "
            f"support_operators=false solve_c={','.join(str(c) for c in SOLVE_C)} "
            "solve_methods=k2 solve_rtol=1e-6"
        )
        print(f"Running command: {cmd}", end="")
        start = time()
        status, out = launch_safe(cmd, nproc=NPROC, mthread=MTHREAD, pipe=True)
        print(f" ... done in {time() - start:.3}s")
        pathlib.Path(ISOC_DIRECTORY, f"run.log.{n}").write_text(out)
        if status:
            print(f"Run failed!\nOutput was:\n{out}")
            sys.exit(status)
        for key in keys[:2]:
            errors[key].append(quiet_collect(f"{key}_error", ISOC_DIRECTORY))
            if quiet_collect(f"{key}_converged", ISOC_DIRECTORY) != 1:
                failures.append(f"{key} GMRES not converged (centroid) n={n}")
        errors[keys[2]].append(quiet_collect(f"{keys[2]}_l_2", ISOC_DIRECTORY))
        integral = abs(quiet_collect(f"{keys[2]}_integral", ISOC_DIRECTORY))
        ok = integral < 1e-12
        print(
            f"div_par_K_grad_par_k2 centroid n={n}: relative volume integral "
            f"{integral:.3e}\t............ {'PASS' if ok else 'FAIL'}"
        )
        if not ok:
            failures.append(f"div_par_K_grad_par_k2 conservation (centroid) n={n}")
    spacing = 1.0 / array(ISO_NLIST)
    for key in keys:
        print(f"{key} centroid errors: " + ", ".join(f"{v:.3e}" for v in errors[key]))
        expected = K2_ORDER_SOLVE_C1 if key == "solve_k2_c1" else K2_ORDER_BOUNDS[key]
        # assert_convergence accepts 0.95 x expected: pass the bound / 0.95
        if not assert_convergence(
            errors[key], spacing, f"{key} centroid", expected / 0.95
        ):
            failures.append(f"{key} centroid")
    return {"n": ISO_NLIST, **{key: {"l_2": e} for key, e in errors.items()}}, failures


def make_plots(cases: dict[str, dict]):
    try:
        import matplotlib.pyplot as plt
    except ImportError:
        print("No matplotlib")
        return

    num_operators = len(OPERATORS)
    fig, axes = plt.subplots(1, num_operators, figsize=(num_operators * 4, 4))

    for ax, operator in zip(axes, OPERATORS):
        for name, case in cases.items():
            ax.loglog(dx, case[operator]["l_2"], "-", label=f"{name} $l_2$")
            ax.loglog(dx, case[operator]["l_inf"], "--", label=f"{name} $l_\\inf$")
        ax.legend(loc="upper left")
        ax.grid()
        ax.set_title(f"Error scaling for {operator}")
        ax.set_xlabel(r"Mesh spacing $\delta z$")
        ax.set_ylabel("Error norm")

    fig.tight_layout()
    fig.savefig("fci_mms.pdf")
    print("Plot saved to fci_mms.pdf")
    plt.close()


