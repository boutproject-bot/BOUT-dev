    )
    args = parser.parse_args()

    failures = []
    # NPROC = 2 ranks, split either along the nodes (x) or along y
    cases = {
        "nslice=1 precomputed NXPE=2": {
            "order": 2,
            "args": f"NXPE=2 solve_c={','.join(str(c) for c in SOLVE_C)}",
