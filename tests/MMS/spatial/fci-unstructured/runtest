    }

    make_grids()

    for name, case in cases.items():
        error2, failures_ = check_fci_operators(name, case)
        case.update(error2)
        failures.extend(failures_)

    failures.extend(check_decomposition(cases))
    failures.extend(check_cylindrical())
    failures.extend(check_cylindrical_sheared())
    isotropic, failures_ = check_isotropic()
